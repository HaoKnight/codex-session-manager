{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codex Session Manager",
  "version": "1.3.0",
  "identifier": "com.knight.codex-session-manager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Codex Session Manager",
        "width": 1320,
        "height": 850,
        "minWidth": 980,
        "minHeight": 680,
        "resizable": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "H-Knight",
    "copyright": "Copyright © 2026 H-Knight",
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      }
    },
    "icon": ["icons/icon.png", "icons/32x32.png", "icons/128x128.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
